// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Confirmado pelo init
  url      = env("DATABASE_URL")
}

enum Role{
  CLIENT
  SELLER
  ADMIN
}

// Modelo de Usuário Principal (pode adicionar mais campos depois)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(CLIENT)
  accounts      Account[] // Relação com Account
  sessions      Session[] // Relação com Session
  produtos      Produto[]
  agendas       Agenda[]
}

// Modelos Padrão para o Auth.js Prisma Adapter

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Produto {
  id         String      @id @default(cuid())
  nome       String
  descricao  String?
  imagemUrl  String?
  preco      Decimal  @db.Decimal(10, 2)
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agenda {
  id         String      @id @default(cuid())
  data       DateTime
  descricao  String?
  sellerId     String
  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
